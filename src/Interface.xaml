<Style TargetType="RadioButton"><Setter Property="Foreground" Value="#DBE5E9"/><Setter Property="Margin" Value="0,12"/><Setter Property="FontSize" Value="15"/></Style>
</Window.Resources>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#15191D" BorderBrush="#283036" BorderThickness="0,0,1,0"><DockPanel Margin="17,27,17,22">
<StackPanel DockPanel.Dock="Top"><Grid Margin="8,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="◈" FontSize="28" Foreground="#94E3C2" Margin="0,0,8,0"/><Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="34"><TextBlock Text="HeadRelay" FontSize="26" FontWeight="Bold" TextWrapping="NoWrap"/></Viewbox></Grid><TextBlock Text="HEAD TRACKING STUDIO" Foreground="#708087" FontSize="9" Margin="8,0,0,38"/>
<Button x:Name="NavDashboard" Style="{StaticResource Nav}" Content="Übersicht"/><Button x:Name="NavDevices" Style="{StaticResource Nav}" Content="Headsets"/><Button x:Name="NavCalibration" Style="{StaticResource Nav}" Content="Kalibrierung"/><Button x:Name="NavOutput" Style="{StaticResource Nav}" Content="Spielanbindung"/><Button x:Name="NavSettings" Style="{StaticResource Nav}" Content="Bewegung"/><Button x:Name="NavDiagnostics" Style="{StaticResource Nav}" Content="Diagnose"/>
</StackPanel><StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><TextBlock Text="HEADRELAY  /  0.2 PREVIEW" FontSize="9" Foreground="#627179" HorizontalAlignment="Center"/></StackPanel><Grid/>
</DockPanel></Border>
<Grid Grid.Column="1" Margin="30,23,30,20"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
<Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Top"><Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#7E8B92" Margin="0,6,9,0" VerticalAlignment="Top"/><TextBlock x:Name="TopStatus" Text="Bereit für dein Headset" Foreground="#A8B5BB"/><TextBlock Text="   /   WINDOWS" Foreground="#516169" FontSize="10" Margin="7,2,0,0"/></StackPanel><TextBlock Text="F9  Zentrieren     F10  Pause" HorizontalAlignment="Right" Foreground="#829098" FontSize="11"/></Grid>
<Grid Grid.Row="1">
<Grid x:Name="PageDashboard"><Grid.RowDefinitions><RowDefinition Height="102"/><RowDefinition Height="*"/><RowDefinition Height="130"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="DEIN SETUP" FontSize="10" Foreground="#94E3C2"/><TextBlock Text="Dein Blick. Deine Kontrolle." Style="{StaticResource Title}"/><TextBlock Text="Headset verbinden. Bewegung anlernen. Ins Cockpit steigen." Style="{StaticResource Small}"/></StackPanel>
<Grid Grid.Row="1" Margin="0,10,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Card}" Padding="22,18"><Grid><Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="*"/><RowDefinition Height="37"/></Grid.RowDefinitions><Grid><TextBlock Text="BEWEGUNGSVORSCHAU" FontSize="10" Foreground="#9BA9AF"/><Border Background="#222D2A" CornerRadius="5" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock x:Name="PreviewBadge" Text="KEIN SIGNAL" FontSize="9" Foreground="#94E3C2"/></Border></Grid><Grid x:Name="PreviewHost" Grid.Row="1"/><Grid Grid.Row="2"><TextBlock x:Name="PreviewHint" Text="Verbinde dein Headset für eine Live-Vorschau." Style="{StaticResource Small}" VerticalAlignment="Center"/><Button x:Name="RecenterButton" Content="Zentrieren" Padding="11,7" HorizontalAlignment="Right"/></Grid></Grid></Border>
<StackPanel Grid.Column="2"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="DEIN HEADSET" FontSize="10" Foreground="#9BA9AF"/><ComboBox x:Name="DeviceChoice" DisplayMemberPath="Name" Margin="0,13,0,10"/><TextBlock x:Name="DeviceHint" Text="Suche nach kompatiblen USB-Geräten …" Style="{StaticResource Small}" MinHeight="39"/><Button x:Name="ConnectButton" Content="Headset verbinden" Style="{StaticResource Primary}" Margin="0,13,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="FÜR DICH EINGESTELLT" FontSize="10" Foreground="#9BA9AF"/><TextBlock x:Name="CalibrationSummary" Text="Noch keine Kalibrierung" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBlock Text="Drei kurze Bewegungen genügen, um deine Kopfbewegungen zuzuordnen." Style="{StaticResource Small}"/><Button x:Name="SetupButton" Content="Headset anlernen →" Margin="0,14,0,0"/></StackPanel></Border></StackPanel></Grid>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="17"><StackPanel><TextBlock Text="LINKS / RECHTS" FontSize="9" Foreground="#82939A"/><TextBlock x:Name="YawValue" Text="0,0°" FontSize="29" FontWeight="Light" Margin="0,8,0,3"/><TextBlock Text="Drehen · Yaw" Style="{StaticResource Small}"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Grid.Column="1" Margin="0,0,12,0" Padding="17"><StackPanel><TextBlock Text="OBEN / UNTEN" FontSize="9" Foreground="#82939A"/><TextBlock x:Name="PitchValue" Text="0,0°" FontSize="29" FontWeight="Light" Margin="0,8,0,3"/><TextBlock Text="Nicken · Pitch" Style="{StaticResource Small}"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Grid.Column="2" Margin="0,0,18,0" Padding="17"><StackPanel><TextBlock Text="SENSORRATE" FontSize="9" Foreground="#82939A"/><TextBlock x:Name="RateValue" Text="— Hz" FontSize="29" FontWeight="Light" Margin="0,8,0,3"/><TextBlock Text="Gemessene Daten" Style="{StaticResource Small}"/></StackPanel></Border>
<Border Grid.Column="3" Style="{StaticResource Card}" Padding="17"><StackPanel><TextBlock x:Name="OutputSummary" Text="Direkt zum Spiel" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="GameSummary" Text="Spielanbindung noch einrichten" Style="{StaticResource Small}" Margin="0,6,0,10"/><Button x:Name="StartButton" Content="Tracking starten" Style="{StaticResource Primary}" Padding="12,8"/></StackPanel></Border></Grid>
</Grid>
<Grid x:Name="PageDevices" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="105"/><RowDefinition Height="*"/><RowDefinition Height="100"/></Grid.RowDefinitions><StackPanel><TextBlock Text="VERBINDUNG" FontSize="10" Foreground="#94E3C2"/><TextBlock Text="Ein Zuhause für deine Headsets." Style="{StaticResource Title}"/><TextBlock Text="Kompatible Geräte werden automatisch erkannt. Neue Modelle brauchen einen passenden Signaladapter." Style="{StaticResource Small}"/></StackPanel><Border Style="{StaticResource Card}" Grid.Row="1"><DockPanel><Button x:Name="RefreshButton" Content="Geräte neu suchen" DockPanel.Dock="Top" HorizontalAlignment="Right" Margin="0,0,0,14"/><ListBox x:Name="DevicesList" Background="Transparent" BorderThickness="0" Foreground="#E6ECEE" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Padding="18" Margin="0,4" Background="#222A2F" CornerRadius="10"><StackPanel><TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding Product}" Foreground="#8FA1AB" Margin="0,7,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListBox.ItemContainerStyle></ListBox></DockPanel></Border><Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18"><TextBlock x:Name="SupportText" Text="Integriert: JBL Quantum 910 und 950. Andere Modelle werden über deklarative Geräteadapter ergänzt. Kalibrierung ordnet die Bewegungsachsen zu; sie ersetzt keinen fehlenden Zugriff auf Sensordaten." Style="{StaticResource Small}"/></Border></Grid>
<Grid x:Name="PageCalibration" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="105"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="DEIN HEADSET ANLERNEN" FontSize="10" Foreground="#94E3C2"/><TextBlock Text="Drei Bewegungen. Dein Setup." Style="{StaticResource Title}"/><TextBlock Text="Die App lernt die tatsächliche Ausrichtung deines Headsets. Halte jede Position kurz ruhig." Style="{StaticResource Small}"/></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="55"/><RowDefinition Height="*"/><RowDefinition Height="110"/></Grid.RowDefinitions><TextBlock x:Name="StepProgress" Text="01  ─────  02  ─────  03" Foreground="#94E3C2" FontSize="18"/><StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock x:Name="StepNumber" Text="01" FontSize="72" Foreground="#314C43" FontWeight="Light"/><TextBlock x:Name="StepTitle" Text="Geradeaus schauen" FontSize="29" FontWeight="SemiBold" Margin="0,10,0,12"/><TextBlock x:Name="StepDescription" Text="Setze dich bequem hin. Schaue auf die Mitte deines Bildschirms und halte den Kopf aufrecht." Foreground="#B1BEC4" FontSize="15" LineHeight="24"/><TextBlock x:Name="CaptureNote" Text="Nach dem Klick hast du 3 Sekunden Zeit." Style="{StaticResource Small}" Margin="0,18,0,0"/></StackPanel><StackPanel Grid.Row="2" VerticalAlignment="Bottom"><Button x:Name="CaptureButton" Content="Position aufnehmen" Style="{StaticResource Primary}"/><Button x:Name="ResetCalibrationButton" Content="Von vorne beginnen" Background="Transparent" BorderThickness="0" Padding="12,8" Margin="0,6,0,0"/></StackPanel></Grid></Border><StackPanel Grid.Column="2"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="SO KLAPPT ES" FontSize="10" Foreground="#94E3C2"/><TextBlock Text="Kleine, klare Bewegungen." FontSize="20" FontWeight="SemiBold" Margin="0,16,0,12"/><TextBlock Text="1   Blick geradeaus, Kopf aufrecht.&#10;&#10;2   Nach rechts drehen – die Nase zeigt nach rechts. Das Ohr bleibt über der Schulter.&#10;&#10;3   Zur Mitte zurück, dann das Kinn heben und nach oben schauen." Foreground="#A9B8BF" LineHeight="23"/><Border Height="1" Background="#313C42" Margin="0,20"/><TextBlock Text="Seitliches Kippen wird getrennt erkannt und hält deinen Horizont im Spiel ruhig." Style="{StaticResource Small}"/></StackPanel></Border><TextBlock x:Name="CalibrationSignal" Text="Verbinde zuerst ein Headset." Style="{StaticResource Small}" Margin="16,18"/></StackPanel></Grid></Grid>
<Grid x:Name="PageOutput" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="110"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="SPIELANBINDUNG" FontSize="10" Foreground="#94E3C2"/><TextBlock Text="Ein direkter Weg ins Cockpit." Style="{StaticResource Title}"/><TextBlock Text="HeadRelay übernimmt Kalibrierung, Glättung und die Ausgabe deiner Kopfbewegungen." Style="{StaticResource Small}"/></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="EMPFOHLEN" Foreground="#94E3C2" FontSize="10"/><RadioButton x:Name="DirectRadio" GroupName="Output" Content="Direkt · TrackIR / FreeTrack" IsChecked="True"/><TextBlock Text="Die eigene HeadRelay-Spielbrücke überträgt deine Kopfbewegungen direkt an kompatible Spiele." Style="{StaticResource Small}"/><TextBlock Text="Einmal einrichten" FontSize="19" FontWeight="SemiBold" Margin="0,25,0,9"/><TextBlock Text="Richte die HeadRelay-Spielbrücke einmal für dein Windows-Benutzerkonto ein. Bisherige Pfade werden gesichert. Danach das Spiel neu starten." Style="{StaticResource Small}"/><Button x:Name="InstallButton" Content="Spielanbindung einrichten" Style="{StaticResource Primary}" Margin="0,20,0,8"/><Button x:Name="RestoreButton" Content="Vorherige Anbindung wiederherstellen" FontSize="11"/><TextBlock x:Name="IntegrationState" Text="Noch nicht eingerichtet" Foreground="#C1CBBE" Margin="0,16,0,0"/><Border Height="1" Background="#313C42" Margin="0,22"/><TextBlock Text="STAR CITIZEN" FontSize="10" Foreground="#94E3C2"/><TextBlock Text="Quelle: TrackIR&#10;Headtracking: aktiviert&#10;Andere Tracking-Programme vorher schließen." Foreground="#ABBCC4" LineHeight="24" Margin="0,10,0,0"/><TextBlock Text="Neue HeadRelay-Spielbrücke: Protokolltests vorhanden. Der Test im laufenden Spiel steht noch aus. Spiele mit Hersteller-Signaturprüfung sind nicht bestätigt." Style="{StaticResource Small}" Margin="0,15,0,0"/></StackPanel></ScrollViewer></Border><Border Style="{StaticResource Card}" Grid.Column="2"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="KOMPATIBILITÄT" Foreground="#899BA5" FontSize="10"/><RadioButton x:Name="UdpRadio" GroupName="Output" Content="Optional · UDP / FreePIE"/><TextBlock Text="Sende die Bewegung an einen separat eingerichteten UDP-Empfänger. Für die direkte Spielanbindung brauchst du diese Option nicht." Style="{StaticResource Small}"/><TextBlock Text="UDP-Empfänger einrichten" FontSize="19" FontWeight="SemiBold" Margin="0,25,0,9"/><TextBlock Text="Eingang: FreePIE UDP&#10;Port: 5555&#10;Ausgang: freetrack / TrackIR&#10;Ausgabe im Empfänger passend zum Spiel wählen" Foreground="#ABBCC4" LineHeight="25"/><Border Height="1" Background="#313C42" Margin="0,24"/><TextBlock Text="Du kannst jederzeit zwischen beiden Ausgaben wechseln. Stoppe das Tracking vor dem Wechsel." Style="{StaticResource Small}"/></StackPanel></ScrollViewer></Border></Grid></Grid>
<Grid x:Name="PageSettings" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="110"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="BEWEGUNG" FontSize="10" Foreground="#94E3C2"/><TextBlock Text="So direkt, wie du es magst." Style="{StaticResource Title}"/><TextBlock Text="Änderungen wirken sofort und werden gespeichert. Die Vorschau zeigt die Ausgabe zum Spiel." Style="{StaticResource Small}"/></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="EMPFINDLICHKEIT" Foreground="#94E3C2" FontSize="10"/><TextBlock x:Name="GainYawLabel" Text="Links / Rechts · 1,50×" FontSize="17" Margin="0,20,0,0"/><Slider x:Name="GainYawSlider" Minimum="0.3" Maximum="4" Value="1.5"/><TextBlock x:Name="GainPitchLabel" Text="Oben / Unten · 1,30×" FontSize="17" Margin="0,18,0,0"/><Slider x:Name="GainPitchSlider" Minimum="0.3" Maximum="4" Value="1.3"/><TextBlock x:Name="CurveLabel" Text="Bewegungskurve · 1,15" FontSize="17" Margin="0,18,0,0"/><Slider x:Name="CurveSlider" Minimum="0.8" Maximum="1.8" Value="1.15"/><TextBlock Text="Eine höhere Kurve macht kleine Bewegungen um die Mitte sanfter und große Bewegungen kräftiger." Style="{StaticResource Small}"/><Border Height="1" Background="#313C42" Margin="0,25,0,15"/><CheckBox x:Name="InvertYawCheck" Content="Links / Rechts umkehren"/><CheckBox x:Name="InvertPitchCheck" Content="Oben / Unten umkehren"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="RUHE UND PRÄZISION" Foreground="#94E3C2" FontSize="10"/><TextBlock x:Name="SmoothingLabel" Text="Glättung · 70 ms" FontSize="17" Margin="0,20,0,0"/><Slider x:Name="SmoothingSlider" Minimum="0" Maximum="200" Value="70"/><TextBlock Text="Weniger Glättung reagiert direkter. Mehr Glättung beruhigt zittrige Bewegungen." Style="{StaticResource Small}"/><TextBlock x:Name="DeadZoneLabel" Text="Ruhezone · 0,5°" FontSize="17" Margin="0,24,0,0"/><Slider x:Name="DeadZoneSlider" Minimum="0" Maximum="4" Value="0.5"/><TextBlock Text="Bewegungen innerhalb dieser Zone lassen den Blick in der Mitte ruhen." Style="{StaticResource Small}"/><Border Height="1" Background="#313C42" Margin="0,25,0,15"/><TextBlock Text="IM SPIEL" FontSize="10" Foreground="#94E3C2"/><TextBlock Text="F9   Blick zentrieren&#10;F10 Tracking pausieren / fortsetzen" Foreground="#ABBCC4" LineHeight="28" Margin="0,10,0,15"/><Button x:Name="DefaultsButton" Content="Bewegung zurücksetzen"/></StackPanel></Border></Grid></Grid>
<Grid x:Name="PageDiagnostics" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="110"/><RowDefinition Height="80"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="DIAGNOSE" FontSize="10" Foreground="#94E3C2"/><TextBlock Text="Sieh, was ankommt." Style="{StaticResource Title}"/><TextBlock Text="Geräte, Signalzustand und Ereignisse." Style="{StaticResource Small}"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="ExportButton" Content="Diagnose als Datei speichern" Style="{StaticResource Primary}"/><Button x:Name="OpenFolderButton" Content="App-Ordner öffnen" Margin="12,0,0,0"/></StackPanel><Border Grid.Row="2" Style="{StaticResource Card}" Padding="16"><TextBox x:Name="LogText" Background="Transparent" Foreground="#A7BFB6" BorderThickness="0" IsReadOnly="True" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Border></Grid>
</Grid>
<Border Grid.Row="2" BorderBrush="#273137" BorderThickness="0,1,0,0" Margin="0,14,0,0"><Grid Margin="0,9,0,0"><TextBlock x:Name="FooterText" Text="Headset verbinden, dann die Kalibrierung starten." Foreground="#81959E" FontSize="11"/><TextBlock Text="USB → HEADRELAY → SPIEL" HorizontalAlignment="Right" Foreground="#536A71" FontSize="9" Margin="0,2,0,0"/></Grid></Border>
</Grid></Grid></Window>