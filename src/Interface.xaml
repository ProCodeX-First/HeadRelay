<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="HeadRelay · Head Tracking Studio" Width="1250" Height="860" MinWidth="1100" MinHeight="760" WindowStartupLocation="CenterScreen" Background="#101316" Foreground="#EBF0F1" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
<Window.Resources>
