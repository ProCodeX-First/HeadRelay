<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>HeadRelay</AssemblyName>
    <StartupObject>HeadRelay.Entry</StartupObject>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>../Assets/HeadRelay.ico</ApplicationIcon>
    <Version>0.2.1</Version>
    <DebugType>none</DebugType>
    <BridgeDirectory Condition="'$(BridgeDirectory)' == ''">../Bridge</BridgeDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Interface.xaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Assets/HeadRelay.ico;../Assets/HeadRelay.svg" Link="Assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Tests/950-packets.txt" Link="Tests/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Adapters/adapter.json.example;../Adapters/README.md" Link="Adapters/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Profiles/games.json;../Profiles/README.md" Link="Profiles/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Licenses/*.txt" Link="Licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../LICENSE;../THIRD_PARTY.md;../README.md" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(BridgeDirectory)/freetrackclient.dll;$(BridgeDirectory)/freetrackclient64.dll;$(BridgeDirectory)/TrackIR.exe" CopyToOutputDirectory="PreserveNewest">
      <Link>Bridge/%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
</Project>
